{
  "name": "dsh-desktop-better-setting",
  "version": "0.1.0",
  "description": "DSH Desktop 更好的设置中心：插件管理（官方/桌面/用户/市场）+ 设置。",
  "keywords": ["dsh-plugin", "deepseek-harness", "desktop", "better-setting"],
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": ["lib", "src", "build-client.js", "README.md"],
  "scripts": { "build": "node build-client.js" },
  "license": "MIT",
  "engines": { "node": ">=18" }
}